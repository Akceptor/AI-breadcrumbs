{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {"type": "command", "command": "python3 ${PLUGIN_ROOT}/scripts/handoff-load.py 2>/dev/null || true", "timeout": 10}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "python3 ${PLUGIN_ROOT}/scripts/ctx-guard.py 2>/dev/null || true", "timeout": 10}
        ]
      }
    ]
  }
}
